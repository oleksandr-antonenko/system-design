{
  "name": "@system-design/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --disable-warning=ExperimentalWarning src/main.ts",
    "build": "tsc --pretty false -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit --pretty false",
    "format": "oxfmt",
    "lint": "oxlint --quiet src"
  },
  "dependencies": {
    "@effect/platform-node": "4.1.0",
    "effect": "4.1.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "oxfmt": "0.66.0",
    "oxlint": "1.85.0",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
